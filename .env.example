DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/nome_do_banco
SECRET_KEY=sua_chave_secreta_aqui
ALGORITHM=HS256
# Validade do token de login, em minutos. 10080 = 7 dias. O front renova o
# token toda vez que a plataforma abre, entao esse prazo vale para sessao
# abandonada: quem usa o ATLAS na semana nao precisa relogar.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Recuperacao de senha, mandada pela API do Gmail (nao SMTP: hospedagens
# como Render/Railway bloqueiam as portas de SMTP no plano free). Rode
# scripts/gerar_refresh_token_gmail.py para gerar as tres credenciais
# abaixo, de preferencia com uma conta do nucleo, nao pessoal.
SMTP_USER=nucleo@exemplo.com
SMTP_FROM=ATLAS <nucleo@exemplo.com>
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Base do link enviado por e-mail. Em producao, o dominio real do front.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
