DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/nome_do_banco
SECRET_KEY=sua_chave_secreta_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Recuperacao de senha. Sem SMTP_HOST o envio falha e o fluxo nao funciona.
# No Gmail, use uma App Password (nao a senha da conta) e de preferencia uma
# conta do nucleo, nao pessoal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nucleo@exemplo.com
SMTP_PASSWORD=sua_app_password_aqui
SMTP_FROM=ATLAS <nucleo@exemplo.com>

# Base do link enviado por e-mail. Em producao, o dominio real do front.
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRE_MINUTES=30
